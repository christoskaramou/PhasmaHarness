{
  "name": "phasma-harness",
  "productName": "Phasma Harness",
  "version": "0.3.6",
  "private": true,
  "description": "A local Windows desktop client for Codex, Claude Code, and Cursor.",
  "author": "Christos Karamoustos",
  "repository": {
    "type": "git",
    "url": "https://github.com/christoskaramou/PhasmaHarness.git"
  },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "tsc -p tsconfig.json",
    "check:providers": "node tools/check-providers.cjs",
    "test": "node --test --test-concurrency=2 tests/*.test.cjs",
    "smoke": "electron tests/ui-startup-smoke.cjs",
    "dist": "npx --yes electron-builder@26.15.3 --win nsis --x64 --publish never",
    "postinstall": "node tools/fetch.cjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@muse-code/sdk": "1.4.11",
    "@napi-rs/canvas": "1.0.11",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "katex": "^0.18.7",
    "marked": "18.0.13",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.4.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.phasma.harness",
    "productName": "Phasma Harness",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "ui/**/*",
      "skills/**/*",
      "benchmarks/**/*",
      "tools/manifest.json",
      "tools/bin/**/*"
    ],
    "win": {
      "icon": "ui/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Phasma-Harness-Setup-${version}.exe"
    }
  },
  "optionalDependencies": {
    "@fugood/node-whisper-linux-x64": "1.1.3",
    "@fugood/node-whisper-linux-x64-vulkan": "1.1.3",
    "@fugood/node-whisper-win32-x64": "1.1.3",
    "@fugood/node-whisper-win32-x64-vulkan": "1.1.3"
  }
}
